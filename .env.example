# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
# Since v1.0.0 all components read this file through dotenv (lib/env.mjs).

# Discord bot token (from https://discord.com/developers/applications -> Bot -> Reset Token).
# Required by: gateway (autorole-logger), config-manager apply/health-check.
DISCORD_TOKEN=paste_your_discord_bot_token_here

# Your server (guild) ID: enable Developer Mode in Discord, right-click the server
# icon -> Copy Server ID. Must be 17-20 digits.
# Required by: gateway (the bot logs THIS guild), config-manager resource validation.
OMNICORD_GUILD=1234567890123456789

# Shared secret for the local integration adapter HTTP API (127.0.0.1:3415).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required by: integration-adapter and every test-adapter-*.mjs suite.
ADAPTER_TOKEN=generate_64_hex_chars_with_the_command_above

# ---- Optional resource tuning (all clamped; safe defaults shown) ----
# These are NEVER required — unset/invalid values fall back to the defaults.
# Health snapshot write interval in ms (5000-300000).
#HEALTH_INTERVAL_MS=20000
# Max size of one log file before rotation, in bytes (1MB-100MB).
#LOG_MAX_BYTES=10485760
# Rotated log files kept per log (1-100).
#LOG_RETENTION_FILES=14
# Message-cache entry lifetime in seconds (300-86400); sweep runs every 300s.
#MESSAGE_CACHE_SWEEP_SECONDS=1800
