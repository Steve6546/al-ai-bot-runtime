# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
# All components read this file through dotenv (lib/env.mjs).

# Discord bot token (from https://discord.com/developers/applications -> Bot -> Reset Token).
# This is the ONLY required setting: the gateway runtime needs nothing else —
# no server ID, no channel IDs, no role IDs.
DISCORD_TOKEN=paste_your_discord_bot_token_here

# Shared secret for the local integration adapter HTTP API (127.0.0.1:3415).
# Required only if you run the adapter (`npm run adapter`). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADAPTER_TOKEN=generate_64_hex_chars_with_the_command_above

# ---- Optional resource tuning (all clamped; safe defaults shown) ----
# These are NEVER required — unset/invalid values fall back to the defaults.
# Health snapshot write interval in ms (5000-300000).
#HEALTH_INTERVAL_MS=20000
# Max size of one log file before rotation, in bytes (1MB-100MB).
#LOG_MAX_BYTES=10485760
# Rotated log files kept per log (1-100).
#LOG_RETENTION_FILES=14
