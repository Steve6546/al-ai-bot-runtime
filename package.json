{
  "name": "al-ai-bot-runtime",
  "version": "3.0.0",
  "description": "Unified Discord runtime — single gateway, 6-channel pipeline, autorole, health, and MCP control layer (6 tools) via hardened adapter. Single Discord service, single lock. Windows/Linux/Docker.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "start:gateway": "node bot-supervisor.mjs --mode=gateway --action=start",
    "start:logger": "node bot-supervisor.mjs --mode=logger --action=start",
    "restart:gateway": "node bot-supervisor.mjs --mode=gateway --action=restart",
    "stop:gateway": "node bot-supervisor.mjs --action=stop",
    "status": "node bot-supervisor.mjs --action=status",
    "adapter": "node integration-adapter.mjs",
    "config:validate": "node config-manager.mjs validate",
    "config:apply": "node config-manager.mjs apply --source=manual",
    "check": "node tools/check.mjs",
    "test": "node tools/run-tests.mjs",
    "test:adapter": "node test-adapter-hardened.mjs",
    "test:pipeline": "node test-pipeline.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.1",
    "zod": "^4.4.3"
  }
}
